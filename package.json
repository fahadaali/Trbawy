{
  "name": "tarbawi-council-platform",
  "version": "0.1.0",
  "private": true,
  "description": "منصة المجلس التربوي — إدارة محاضر الاجتماعات والتقييمات التربوية",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute tarbawi-db --local --file=./migrations/0001_init.sql",
    "db:seed": "wrangler d1 execute tarbawi-db --local --file=./migrations/0002_seed.sql",
    "db:migrate": "wrangler d1 migrations apply tarbawi-db",
    "db:init:remote": "wrangler d1 execute tarbawi-db --remote --file=./migrations/0001_init.sql",
    "db:seed:remote": "wrangler d1 execute tarbawi-db --remote --file=./migrations/0002_seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.95.0"
  }
}
